{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Build Mod",
      "type": "shell",
      "command": "gradle",
      "args": [
        "build"
      ],
      "group": "build",
      "problemMatcher": []
    },
    {
      "label": "Build + Deploy to ATLauncher Test Instance",
      "type": "shell",
      "command": "powershell",
      "args": [
        "-NoProfile",
        "-ExecutionPolicy",
        "Bypass",
        "-File",
        "${workspaceFolder}\\scripts\\deploy-to-atlauncher.ps1"
      ],
      "group": "build",
      "problemMatcher": []
    },
    {
      "label": "Run Strict Dev Server",
      "type": "shell",
      "command": "powershell",
      "args": [
        "-NoProfile",
        "-ExecutionPolicy",
        "Bypass",
        "-File",
        "${workspaceFolder}\\scripts\\run-strict-dev-server.ps1"
      ],
      "group": "build",
      "problemMatcher": []
    },
    {
      "label": "Run Strict Dev Session",
      "type": "shell",
      "command": "powershell",
      "args": [
        "-NoProfile",
        "-ExecutionPolicy",
        "Bypass",
        "-File",
        "${workspaceFolder}\\scripts\\run-strict-dev-session.ps1"
      ],
      "group": "build",
      "problemMatcher": []
    },
    {
      "label": "Run Strict Manual Debug Session",
      "type": "shell",
      "command": "powershell",
      "args": [
        "-NoProfile",
        "-ExecutionPolicy",
        "Bypass",
        "-File",
        "${workspaceFolder}\\scripts\\run-strict-manual-debug-session.ps1"
      ],
      "group": "build",
      "problemMatcher": []
    },
    {
      "label": "Collect Throw Debug Bundle",
      "type": "shell",
      "command": "powershell",
      "args": [
        "-NoProfile",
        "-ExecutionPolicy",
        "Bypass",
        "-File",
        "${workspaceFolder}\\scripts\\collect-throw-debug-bundle.ps1"
      ],
      "group": "build",
      "problemMatcher": []
    }
  ]
}
