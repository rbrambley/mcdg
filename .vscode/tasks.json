{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Build Mod",
      "type": "shell",
      "command": "gradle",
      "args": [
        "build"
      ],
      "group": "build",
      "problemMatcher": []
    },
    {
      "label": "Build + Deploy to ATLauncher Test Instance",
      "type": "shell",
      "command": "powershell",
      "args": [
        "-NoProfile",
        "-ExecutionPolicy",
        "Bypass",
        "-File",
        "${workspaceFolder}\\scripts\\deploy-to-atlauncher.ps1"
      ],
      "group": "build",
      "problemMatcher": []
    }
  ]
}
