---
import MainLayout from '../layouts/MainLayout.astro';
import Sidebar from '../components/layout/Sidebar.astro';

const base = import.meta.env.BASE_URL;
---

<MainLayout title="About | MCDG" description="About the MCDG Minecraft Disc Golf mod project.">
  <div class="container page-layout">
    <Sidebar />
    <article class="content card">
      <h1>About MCDG</h1>
      <p><strong>MCDG — Minecraft Disc Golf</strong> is a Fabric mod for Minecraft 1.20.6 that adds procedural disc golf courses, calculated disc flight physics, multiplayer rounds, and a full resort management system to the game.</p>

      <h2>Project Goals</h2>
      <ul>
        <li>Bring disc golf gameplay into Minecraft with authentic flight mechanics.</li>
        <li>Support procedural course generation across varied biomes and terrain.</li>
        <li>Enable multiplayer stroke-play with turn order, scoring, and strict landing rules.</li>
        <li>Provide survival-mode progression through crafting tiers, skills, and challenge courses.</li>
      </ul>

      <h2>Repository</h2>
      <p>Development happens at <a href="https://github.com/rbrambley/mcdg">github.com/rbrambley/mcdg</a>. The site itself lives in the <code>docs/</code> folder of the same repository and is deployed automatically to GitHub Pages.</p>

      <h2>License</h2>
      <p>All rights reserved.</p>

      <p><a href={`${base}`} class="btn">Back Home</a></p>
    </article>
  </div>
</MainLayout>

<style>
  .content {
    max-width: 100%;
  }

  .content h1 {
    margin-top: 0;
  }
</style>
