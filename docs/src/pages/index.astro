---
import MainLayout from '../layouts/MainLayout.astro';

const base = import.meta.env.BASE_URL;

const features = [
  {
    title: 'Procedural Courses',
    description: 'Generate biome-aware disc golf courses across varied terrain, from rolling meadows to challenging hazard layouts.',
    href: `${base}features/courses/`,
    icon: 'map',
  },
  {
    title: 'Calculated Flight Physics',
    description: 'A dedicated trajectory system models stance, release angle, wind, fade, and disc glide ratings.',
    href: `${base}features/physics/`,
    icon: 'physics',
  },
  {
    title: 'Resort System',
    description: 'Build and manage a central resort with lobbies, housing, lighting, and multiple course anchors.',
    href: `${base}features/resort/`,
    icon: 'resort',
  },
  {
    title: 'Multiplayer Rounds',
    description: 'Run stroke-play rounds with turn order enforcement, strict landing rules, and live scoreboards.',
    href: `${base}guide/multiplayer/`,
    icon: 'multiplayer',
  },
  {
    title: 'Disc Enchantments',
    description: 'Upgrade discs and earn enchanted equipment through challenge courses and boss holes.',
    href: `${base}features/enchantments/`,
    icon: 'enchant',
  },
  {
    title: 'Progression & Skills',
    description: 'Unlock crafting tiers, skills, and accessories as you advance from wooden to netherite discs.',
    href: `${base}progression/skill-unlocks/`,
    icon: 'progression',
  },
];

const icons: Record<string, string> = {
  map: 'M3 6l9 4 9-4M3 6v12l9 4 9-4V6M3 6l9-4 9 4',
  physics: 'M12 2a10 10 0 100 20 10 10 0 000-20zm0 4a6 6 0 110 12 6 6 0 010-12zm0 2a4 4 0 100 8 4 4 0 000-8z',
  resort: 'M3 21h18M4 18h16M6 18V8l6-4 6 4v10M9 18v-6h6v6',
  multiplayer: 'M16 21v-2a4 4 0 00-4-4H6a4 4 0 00-4 4v2M9 11a4 4 0 100-8 4 4 0 000 8zM22 21v-2a4 4 0 00-3-3.87M16 3.13a4 4 0 010 7.75',
  enchant: 'M12 2l2.4 7.2h7.6l-6 4.8 2.4 7.2-6-4.8-6 4.8 2.4-7.2-6-4.8h7.6L12 2z',
  progression: 'M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z',
};
---

<MainLayout title="MCDG — Minecraft Disc Golf" description="A Fabric mod for Minecraft 1.20.6 that brings procedural disc golf courses, multiplayer rounds, and a full resort system to your world.">
  <section class="hero">
    <div class="container">
      <div class="hero-badge">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <circle cx="12" cy="12" r="10"></circle>
          <path d="M8 12s1.5-2 4-2 4 2 4 2"></path>
          <path d="M12 12v4"></path>
        </svg>
        <span>Minecraft Disc Golf</span>
      </div>
      <h1><span>MCDG</span> — Minecraft Disc Golf</h1>
      <p>Build procedural courses, compete with friends, and manage your own disc golf resort in Minecraft 1.20.6.</p>
      <div class="hero-actions">
        <a href={`${base}guide/installation/`} class="btn">Get Started</a>
        <a href={`${base}guide/gameplay/`} class="btn btn-secondary">How to Play</a>
        <a href="https://github.com/rbrambley/mcdg" class="btn btn-secondary">GitHub</a>
      </div>
    </div>
  </section>

  <section class="container features-section">
    <h2>Features</h2>
    <div class="card-grid">
      {features.map(feature => (
        <a href={feature.href} class="card feature-card">
          <div class="feature-icon" aria-hidden="true">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d={icons[feature.icon]}></path>
            </svg>
          </div>
          <h3>{feature.title}</h3>
          <p>{feature.description}</p>
        </a>
      ))}
    </div>
  </section>

  <section class="container">
    <h2>Quick Start</h2>
    <div class="card">
      <ol>
        <li>Install Fabric for Minecraft <strong>1.20.6</strong> and Java <strong>21</strong>.</li>
        <li>Download the latest test pack from the <a href="https://github.com/rbrambley/mcdg/releases">releases page</a>.</li>
        <li>Merge the client pack into your Minecraft instance.</li>
        <li>Join a world or server, press <kbd>G</kbd>, and choose <strong>Auto Build Course</strong>.</li>
        <li>Start a round, invite other players, and throw!</li>
      </ol>
      <p><a href={`${base}guide/installation/`} class="btn">Full Installation Guide</a></p>
    </div>
  </section>
</MainLayout>

<style>
  .hero-badge {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    background: var(--bg-tertiary);
    border: 1px solid var(--border);
    color: var(--accent);
    padding: 0.4rem 0.85rem;
    border-radius: 999px;
    font-size: 0.9rem;
    font-weight: 600;
    margin-bottom: 1.25rem;
  }

  .hero-badge svg {
    width: 1.1rem;
    height: 1.1rem;
  }

  .feature-card {
    display: block;
    transition: transform 0.15s ease, border-color 0.15s ease, box-shadow 0.2s ease;
  }

  .feature-card:hover {
    transform: translateY(-3px);
    border-color: var(--accent);
    box-shadow: 0 8px 24px rgba(0, 255, 136, 0.1);
    text-decoration: none;
  }

  .feature-card h3 {
    color: var(--accent);
    margin-top: 0.75rem;
  }

  .feature-icon {
    width: 3rem;
    height: 3rem;
    display: flex;
    align-items: center;
    justify-content: center;
    background: var(--accent-dim);
    border-radius: var(--radius);
    color: var(--accent);
  }

  .feature-icon svg {
    width: 1.5rem;
    height: 1.5rem;
  }

  section.container {
    padding-top: 3rem;
    padding-bottom: 3rem;
  }

  .features-section {
    background: linear-gradient(180deg, var(--bg-primary) 0%, var(--bg-secondary) 100%);
  }
</style>
