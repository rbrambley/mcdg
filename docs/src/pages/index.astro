---
import MainLayout from '../layouts/MainLayout.astro';
import Hero from '../components/ui/Hero.astro';
import FeatureCard from '../components/ui/FeatureCard.astro';
import DiscStats from '../components/ui/DiscStats.astro';
import ScreenshotPlaceholder from '../components/ui/ScreenshotPlaceholder.astro';
const baseUrl = import.meta.env.BASE_URL.endsWith('/') ? import.meta.env.BASE_URL : import.meta.env.BASE_URL + '/';
---

<MainLayout 
  title="MCDG - Minecraft Disc Golf"
  description="A Fabric mod for Minecraft 1.20.6 that brings disc golf to your world. Build procedural courses, compete in multiplayer rounds, and manage a full resort experience."
>
  <Hero 
    title="MCDG"
    subtitle="Minecraft Disc Golf"
    description="A Fabric mod for Minecraft 1.20.6 that brings disc golf to your world. Build procedural courses, compete in multiplayer rounds, and manage a full resort experience."
    ctaText="Get Started"
    ctaHref="/guide/installation"
    backgroundImage="/images/hero-bg.png"
  />

  <section class="hero-image-section">
    <div class="container">
      <!-- Replace ScreenshotPlaceholder with actual image when available -->
      <ScreenshotPlaceholder 
        title="MCDG Gameplay Screenshot"
        description="In-game screenshot showing disc golf gameplay"
        width="100%"
        height="500px"
      />
      <!-- 
      <img 
        src={`${baseUrl}images/screenshots/mcdg-gameplay.png`} 
        alt="MCDG Gameplay Screenshot"
        class="hero-screenshot"
        loading="lazy"
      />
      -->
    </div>
  </section>

  <section class="features-section">
    <h2 class="section-title">Key Features</h2>
    <div class="features-grid">
      <FeatureCard 
        title="Procedural Courses"
        description="Automatically generate disc golf courses in any biome with terrain-aware hole placement and hazard systems."
        icon="🏞️"
        href={`${baseUrl}features/courses`}
      />
      <FeatureCard 
        title="Realistic Physics"
        description="Authentic disc flight simulation with glide phases, fade curves, wind effects, and multiple throw stances."
        icon="🎯"
        href={`${baseUrl}features/physics`}
      />
      <FeatureCard 
        title="Multiplayer Rounds"
        description="Compete with friends in stroke-play rounds with live leaderboards, turn management, and scoring systems."
        icon="👥"
        href={`${baseUrl}guide/multiplayer`}
      />
      <FeatureCard 
        title="Disc Progression"
        description="Craft discs from wooden to netherite, each with unique flight characteristics and enchantment options."
        icon="⚒️"
        href={`${baseUrl}guide/crafting`}
        tier="diamond"
      />
      <FeatureCard 
        title="Resort System"
        description="Auto-build central resorts with housing, courtyards, and surrounding courses for a complete experience."
        icon="🏨"
        href={`${baseUrl}features/resort`}
      />
      <FeatureCard 
        title="Challenge Courses"
        description="Discover lost courses, face boss hole mobs, and earn enchanted equipment rewards."
        icon="⚔️"
        href={`${baseUrl}guide/challenge-courses`}
        tier="gold"
      />
      <FeatureCard 
        title="Skill Progression"
        description="Unlock advanced equipment through skill-based achievements and performance milestones."
        icon="🏆"
        href={`${baseUrl}progression/skill-unlocks`}
        tier="netherite"
      />
    </div>
  </section>

  <section class="disc-stats-section">
    <h2 class="section-title">Disc Flight Ratings</h2>
    <p class="section-description">Each disc tier has unique flight characteristics that affect distance, accuracy, and control.</p>
    
    <div class="disc-stats-grid">
      <DiscStats 
        discName="Training Disc"
        speed={3}
        glide={4}
        turn={0}
        fade={1}
        tier="training"
      />
      <DiscStats 
        discName="Wooden Disc"
        speed={4}
        glide={3}
        turn={-1}
        fade={1}
        tier="wooden"
      />
      <DiscStats 
        discName="Stone Disc"
        speed={5}
        glide={3}
        turn={0}
        fade={1}
        tier="stone"
      />
      <DiscStats 
        discName="Iron Disc"
        speed={6}
        glide={4}
        turn={0}
        fade={2}
        tier="iron"
      />
      <DiscStats 
        discName="Gold Disc"
        speed={7}
        glide={5}
        turn={-1}
        fade={1}
        tier="gold"
      />
      <DiscStats 
        discName="Diamond Disc"
        speed={9}
        glide={6}
        turn={0}
        fade={3}
        tier="diamond"
      />
      <DiscStats 
        discName="Netherite Disc"
        speed={11}
        glide={7}
        turn={1}
        fade={4}
        tier="netherite"
      />
    </div>
  </section>

  <section class="quick-start-section">
    <h2 class="section-title">Quick Start</h2>
    <div class="quick-steps">
      <div class="step">
        <div class="step-number">1</div>
        <h3>Install the Mod</h3>
        <p>Download the latest test pack and install it on your Minecraft 1.20.6 Fabric instance.</p>
        <a href={`${baseUrl}guide/installation`} class="button button-secondary">Installation Guide</a>
      </div>
      <div class="step">
        <div class="step-number">2</div>
        <h3>Learn the Basics</h3>
        <p>Master throw stances, release angles, and disc flight mechanics.</p>
        <a href={`${baseUrl}guide/gameplay`} class="button button-secondary">Gameplay Guide</a>
      </div>
      <div class="step">
        <div class="step-number">3</div>
        <h3>Build Your Course</h3>
        <p>Use the auto-build system to generate procedural courses in any biome.</p>
        <a href={`${baseUrl}guide/admin-commands`} class="button button-secondary">Course Commands</a>
      </div>
    </div>
  </section>

  <section class="requirements-section">
    <h2 class="section-title">Requirements</h2>
    <div class="requirements-grid">
      <div class="requirement-card">
        <h3>Minecraft</h3>
        <p>1.20.6</p>
      </div>
      <div class="requirement-card">
        <h3>Fabric Loader</h3>
        <p>0.19.3</p>
      </div>
      <div class="requirement-card">
        <h3>Java</h3>
        <p>21</p>
      </div>
    </div>
  </section>
</MainLayout>

<style>
  .hero-image-section {
    padding: 2rem 1rem;
    background: linear-gradient(180deg, var(--color-background) 0%, var(--color-background-secondary) 100%);
  }

  .features-section,
  .disc-stats-section,
  .quick-start-section,
  .requirements-section {
    padding: 4rem 1rem;
  }

  .section-title {
    text-align: center;
    font-size: 2.5rem;
    color: var(--color-text-primary);
    margin-bottom: 1rem;
  }

  .section-description {
    text-align: center;
    color: var(--color-text-secondary);
    max-width: 600px;
    margin: 0 auto 2rem;
  }

  .features-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
    gap: 1.5rem;
    max-width: 1200px;
    margin: 0 auto;
  }

  .disc-stats-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
    gap: 1rem;
    max-width: 1200px;
    margin: 0 auto;
  }

  .quick-steps {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
    gap: 2rem;
    max-width: 900px;
    margin: 0 auto;
  }

  .step {
    text-align: center;
    padding: 2rem;
    background-color: var(--color-background-secondary);
    border: 1px solid var(--color-border);
    border-radius: 0.75rem;
  }

  .step-number {
    width: 50px;
    height: 50px;
    background-color: var(--color-accent);
    color: var(--color-background);
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 1.5rem;
    font-weight: 700;
    margin: 0 auto 1rem;
  }

  .step h3 {
    color: var(--color-text-primary);
    margin-bottom: 0.5rem;
  }

  .step p {
    color: var(--color-text-secondary);
    margin-bottom: 1rem;
  }

  .requirements-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
    gap: 1rem;
    max-width: 600px;
    margin: 0 auto;
  }

  .requirement-card {
    background-color: var(--color-background-secondary);
    border: 1px solid var(--color-border);
    border-radius: 0.5rem;
    padding: 1.5rem;
    text-align: center;
  }

  .requirement-card h3 {
    color: var(--color-accent);
    margin-bottom: 0.5rem;
  }

  .requirement-card p {
    color: var(--color-text-primary);
    font-size: 1.25rem;
    font-weight: 600;
  }

  @media (max-width: 768px) {
    .features-section,
    .disc-stats-section,
    .quick-start-section,
    .requirements-section {
      padding: 2rem 1rem;
    }

    .section-title {
      font-size: 2rem;
    }

    .features-grid,
    .disc-stats-grid,
    .quick-steps {
      grid-template-columns: 1fr;
    }
  }
</style>
