---
import MainLayout from '../layouts/MainLayout.astro';
import Sidebar from '../components/layout/Sidebar.astro';

type PageMeta = { title: string; description: string; md?: string };

export function getStaticPaths() {
  const pageMeta: Record<string, PageMeta> = {
    'guide/stances-angles': { title: 'Stances & Angles', description: 'How throw stance and release angle affect disc flight.', md: 'DISC-GLIDE-PHYSICS.md' },
    'guide/progression': { title: 'Progression', description: 'Crafting tiers, skills, and accessory unlocks.', md: 'CRAFTING-PROGRESSION-SYSTEM.md' },
    'guide/multiplayer': { title: 'Multiplayer', description: 'Joining and playing MCDG multiplayer rounds.', md: 'MULTIPLAYER-TEST-SHEET.md' },
    'guide/admin-commands': { title: 'Admin Commands', description: 'Complete reference for MCDG admin commands.' },
    'guide/hazards': { title: 'Hazards', description: 'Hazard types and strategies for playing them.' },
    'guide/biome-courses': { title: 'Biome Courses', description: 'Biome-specific course characteristics.' },
    'guide/challenge-courses': { title: 'Challenge Courses', description: 'Boss holes and lost course challenges.' },
    'features/physics': { title: 'Flight Physics', description: 'Deep dive into MCDG disc flight physics.', md: 'DISC-FLIGHT-SIMULATION.md' },
    'features/courses': { title: 'Course Generation', description: 'How procedural courses and challenge layouts are generated.' },
    'features/wind-system': { title: 'Wind System', description: 'Wind mechanics and how they affect throws.', md: 'WIND-SYSTEM-PLAN.md' },
    'features/enchantments': { title: 'Enchantments', description: 'Disc enchantments and enchanted equipment rewards.' },
    'features/accessories': { title: 'Accessories', description: 'Disc bags and accessory items.' },
    'features/round-rewards': { title: 'Round Rewards', description: 'Survival mode rewards for throws and rounds.', md: 'SURVIVAL-ENHANCEMENTS-PLAN.md' },
    'features/resort': { title: 'Resort System', description: 'Resort structures and course anchors.', md: 'RESORT-PLAN.md' },
    'features/progression': { title: 'Progression Systems', description: 'Overview of crafting and skill progression.' },
    'admin/server-setup': { title: 'Server Setup', description: 'Hosting an MCDG server.', md: 'SERVER-SETUP-GUIDE.md' },
    'admin/permissions': { title: 'Permissions', description: 'Permission system guide for server admins.' },
    'admin/course-management': { title: 'Course Management', description: 'Building, cleaning up, and managing courses.' },
    'progression/skill-unlocks': { title: 'Skill Unlocks', description: 'Achievement-based progression and skill unlocks.' },
    'progression/questline': { title: 'Questline', description: 'Storyline and exploration quests.', md: 'DISC-GOLF-QUESTLINE-PLAN.md' },
    'progression/crafting-tree': { title: 'Crafting Tree', description: 'Interactive crafting progression visualization.', md: 'CRAFTING-PROGRESSION-SYSTEM.md' },
    'reference/physics': { title: 'Physics Reference', description: 'Complete physics constants and formulas.' },
    'reference/config': { title: 'Configuration', description: 'All server and client config options.' },
    'reference/api': { title: 'API Reference', description: 'API reference for modders integrating with MCDG.' },
    'community/showcase': { title: 'Showcase', description: 'Featured servers, builds, and player submissions.' },
    'community/contributing': { title: 'Contributing', description: 'How to contribute to MCDG.' },
    'community/faq': { title: 'FAQ', description: 'Common gameplay and technical questions.' },
  };

  return Object.entries(pageMeta).map(([slug, meta]) => ({
    params: { slug },
    props: { meta },
  }));
}

const { meta } = Astro.props;
const mdUrl = meta.md ? `https://github.com/rbrambley/mcdg/blob/main/${meta.md}` : null;
---

<MainLayout title={`${meta.title} | MCDG`} description={meta.description}>
  <div class="container page-layout">
    <Sidebar />
    <article class="content card">
      <h1>{meta.title}</h1>
      <p>{meta.description}</p>
      <p>This page is a placeholder. Full content is being migrated from the project documentation.</p>
      {mdUrl && (
        <p><a href={mdUrl} class="btn">Read the source doc on GitHub</a></p>
      )}
    </article>
  </div>
</MainLayout>

<style>
  .content {
    max-width: 100%;
  }

  .content h1 {
    margin-top: 0;
  }
</style>
