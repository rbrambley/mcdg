---
const baseUrl = import.meta.env.BASE_URL.endsWith('/') ? import.meta.env.BASE_URL : import.meta.env.BASE_URL + '/';
const navigation = [
  { title: 'Guide', href: `${baseUrl}guide/installation` },
  { title: 'Features', href: `${baseUrl}features/physics` },
  { title: 'Progression', href: `${baseUrl}progression/skill-unlocks` },
];
---

<header class="site-header">
  <div class="container header-content">
    <a href={baseUrl} class="logo">
      <span class="logo-text">MCDG</span>
      <span class="logo-subtitle">Minecraft Disc Golf</span>
    </a>

    <nav class="desktop-nav">
      <ul class="nav-list">
        {navigation.map((item) => (
          <li>
            <a href={item.href} class="nav-link">{item.title}</a>
          </li>
        ))}
      </ul>
    </nav>

    <button class="mobile-menu-button" aria-label="Toggle menu">
      <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
        <line x1="3" y1="12" x2="21" y2="12"></line>
        <line x1="3" y1="6" x2="21" y2="6"></line>
        <line x1="3" y1="18" x2="21" y2="18"></line>
      </svg>
    </button>
  </div>

  <nav class="mobile-nav">
    <ul class="mobile-nav-list">
      {navigation.map((item) => (
        <li>
          <a href={item.href} class="mobile-nav-link">{item.title}</a>
        </li>
      ))}
    </ul>
  </nav>
</header>

<style>
  .site-header {
    background-color: var(--color-background-secondary);
    border-bottom: 1px solid var(--color-border);
    position: sticky;
    top: 0;
    z-index: 100;
  }

  .header-content {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 1rem;
  }

  .logo {
    display: flex;
    flex-direction: column;
    text-decoration: none;
    color: var(--color-text-primary);
  }

  .logo-text {
    font-size: 1.5rem;
    font-weight: 700;
    color: var(--color-accent);
  }

  .logo-subtitle {
    font-size: 0.75rem;
    color: var(--color-text-secondary);
  }

  .nav-list {
    display: flex;
    list-style: none;
    gap: 2rem;
  }

  .nav-link {
    color: var(--color-text-secondary);
    text-decoration: none;
    font-weight: 500;
    transition: color 0.2s ease;
  }

  .nav-link:hover {
    color: var(--color-accent);
  }

  .mobile-menu-button {
    display: none;
    background: none;
    border: none;
    color: var(--color-text-primary);
    cursor: pointer;
    padding: 0.5rem;
  }

  .mobile-nav {
    display: none;
    background-color: var(--color-background-tertiary);
    border-top: 1px solid var(--color-border);
  }

  .mobile-nav.hidden {
    display: none;
  }

  .mobile-nav-list {
    list-style: none;
    padding: 1rem;
  }

  .mobile-nav-list li {
    margin-bottom: 0.5rem;
  }

  .mobile-nav-link {
    display: block;
    padding: 0.75rem;
    color: var(--color-text-secondary);
    text-decoration: none;
    border-radius: 0.25rem;
  }

  .mobile-nav-link:hover {
    background-color: var(--color-background-secondary);
    color: var(--color-accent);
  }

  @media (max-width: 768px) {
    .desktop-nav {
      display: none;
    }

    .mobile-menu-button {
      display: block;
    }

    .mobile-nav {
      display: block;
    }
  }
</style>

<script>
  const menuButton = document.querySelector('.mobile-menu-button');
  const mobileNav = document.querySelector('.mobile-nav');

  menuButton?.addEventListener('click', () => {
    mobileNav?.classList.toggle('hidden');
  });
</script>
