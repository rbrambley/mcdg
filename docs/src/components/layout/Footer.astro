---
const year = new Date().getFullYear();
---

<footer class="site-footer">
  <div class="container footer-inner">
    <p>&copy; {year} MCDG — Minecraft Disc Golf. All rights reserved.</p>
    <p>
      <a href="https://github.com/rbrambley/mcdg">GitHub Repository</a>
    </p>
  </div>
</footer>

<style>
  .site-footer {
    border-top: 1px solid var(--border);
    background: var(--bg-secondary);
    padding: 2rem 1rem;
    margin-top: auto;
  }

  .footer-inner {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 1rem;
    color: var(--text-secondary);
    font-size: 0.9rem;
  }

  .footer-inner p {
    margin: 0;
  }
</style>
