---
interface Props {
  items: Array<{ title: string; href: string }>;
  activeItem?: string;
}

const baseUrl = import.meta.env.BASE_URL.endsWith('/') ? import.meta.env.BASE_URL : import.meta.env.BASE_URL + '/';
const { items, activeItem } = Astro.props;
---

<aside class="sidebar">
  <h3>Guide Contents</h3>
  <ul class="sidebar-list">
    {items.map((item) => (
      <li>
        <a 
          href={item.href?.startsWith(baseUrl) ? item.href : (item.href?.startsWith('/') ? baseUrl + item.href.slice(1) : item.href)}
          class={`sidebar-link ${activeItem === item.title.toLowerCase().replace(' ', '-') ? 'active' : ''}`}
        >
          {item.title}
        </a>
      </li>
    ))}
  </ul>
</aside>

<style>
  .sidebar {
    padding: 0;
  }

  .sidebar h3 {
    font-size: 1rem;
    color: var(--color-text-primary);
    margin-bottom: 1rem;
    padding-bottom: 0.5rem;
    border-bottom: 1px solid var(--color-border);
  }

  .sidebar-list {
    list-style: none;
    padding: 0;
    margin: 0;
  }

  .sidebar-list li {
    margin-bottom: 0.25rem;
  }

  .sidebar-link {
    display: block;
    padding: 0.5rem 0.75rem;
    color: var(--color-text-secondary);
    text-decoration: none;
    border-radius: 0.25rem;
    font-size: 0.875rem;
    transition: all 0.2s ease;
  }

  .sidebar-link:hover {
    background-color: var(--color-background-tertiary);
    color: var(--color-text-primary);
  }

  .sidebar-link.active {
    background-color: rgba(0, 255, 136, 0.1);
    color: var(--color-accent);
    font-weight: 500;
  }
</style>
