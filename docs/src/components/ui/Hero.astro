---
interface Props {
  title: string;
  subtitle: string;
  description?: string;
  ctaText?: string;
  ctaHref?: string;
  backgroundImage?: string;
}

const baseUrl = import.meta.env.BASE_URL.endsWith('/') ? import.meta.env.BASE_URL : import.meta.env.BASE_URL + '/';
const { 
  title, 
  subtitle, 
  description, 
  ctaText = "Get Started", 
  ctaHref = "/guide/installation",
  backgroundImage 
} = Astro.props;

const resolvedCtaHref = ctaHref?.startsWith(baseUrl) ? ctaHref : (ctaHref?.startsWith('/') ? baseUrl + ctaHref.slice(1) : ctaHref);
const resolvedBackgroundImage = backgroundImage?.startsWith(baseUrl) ? backgroundImage : (backgroundImage?.startsWith('/') ? baseUrl + backgroundImage.slice(1) : backgroundImage);
---

<section class="hero" style={resolvedBackgroundImage ? `background-image: url(${resolvedBackgroundImage})` : ''}>
  <div class="hero-content">
    <span class="hero-subtitle">{subtitle}</span>
    <h1 class="hero-title">{title}</h1>
    {description && <p class="hero-description">{description}</p>}
    <div class="hero-cta">
      <a href={resolvedCtaHref} class="button button-primary">{ctaText}</a>
      <a href={`${baseUrl}guide/gameplay`} class="button button-secondary">Learn More</a>
    </div>
  </div>
</section>

<style>
  .hero {
    background-color: var(--color-background-secondary);
    background-size: cover;
    background-position: center center;
    min-height: 90vh;
    display: flex;
    align-items: flex-end;
    justify-content: center;
    padding: 0;
    text-align: center;
    position: relative;
    overflow: hidden;
  }

  .hero::before {
    content: '';
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    background: linear-gradient(180deg, rgba(15, 15, 26, 0.2) 0%, rgba(15, 15, 26, 0.1) 30%, rgba(15, 15, 26, 0.5) 60%, rgba(15, 15, 26, 0.92) 100%);
    z-index: 1;
  }

  .hero::after {
    content: '';
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    background: radial-gradient(ellipse at 50% 30%, transparent 0%, rgba(15, 15, 26, 0.5) 100%);
    z-index: 1;
  }

  .hero-content {
    position: relative;
    z-index: 2;
    max-width: 900px;
    width: 100%;
    margin: 0 auto;
    padding: 3rem 2rem 5rem;
  }

  .hero-title {
    font-size: 4rem;
    font-weight: 800;
    color: var(--color-text-primary);
    margin-bottom: 1.25rem;
    line-height: 1.05;
    text-shadow: 0 0 50px rgba(0, 0, 0, 0.9), 0 4px 20px rgba(0, 0, 0, 0.7);
    letter-spacing: -0.02em;
  }

  .hero-subtitle {
    display: inline-block;
    color: var(--color-accent);
    font-weight: 700;
    font-size: 1.1rem;
    text-transform: uppercase;
    letter-spacing: 0.15em;
    margin-bottom: 1rem;
    text-shadow: 0 0 20px rgba(0, 0, 0, 0.9), 0 2px 8px rgba(0, 0, 0, 0.8);
  }

  .hero-description {
    font-size: 1.25rem;
    color: var(--color-text-primary);
    margin-bottom: 2rem;
    line-height: 1.7;
    text-shadow: 0 0 30px rgba(0, 0, 0, 0.9), 0 2px 8px rgba(0, 0, 0, 0.8);
    max-width: 700px;
    margin-left: auto;
    margin-right: auto;
  }

  .hero-cta {
    display: flex;
    gap: 1rem;
    justify-content: center;
    flex-wrap: wrap;
  }

  @media (max-width: 768px) {
    .hero {
      padding: 0;
    }

    .hero-content {
      padding: 3rem 1rem 5rem;
    }

    .hero-title {
      font-size: 2rem;
    }

    .hero-description {
      font-size: 1rem;
    }

    .hero-cta {
      flex-direction: column;
      align-items: center;
    }

    .hero-cta .button {
      width: 100%;
      max-width: 300px;
    }
  }
</style>
